# Signing key for session cookies. MUST be replaced with a random value —
# anyone who knows this string can forge a session and log in as any user.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE-ME-WITH-A-RANDOM-VALUE

DATABASE_URL=mysql+pymysql://root:19121987@localhost/hospital_vibe

# Set to 1 once the site is served over HTTPS — it marks the session cookie
# Secure. Leaving it on over plain HTTP makes the cookie undeliverable and
# nobody can log in.
SESSION_COOKIE_SECURE=0

# Set to 1 only when a reverse proxy really sits in front of the app: it makes
# the app trust X-Forwarded-* headers, which a direct client could forge.
TRUST_PROXY=0

# Rolling application log. Leave empty to log to stderr only.
LOG_FILE=logs/hospital.log
